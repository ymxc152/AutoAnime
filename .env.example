# AutoAnime v2 环境变量样例（复制为 .env 后按需修改；.env 不进 git）
# ⚠️ 本文件不得包含任何真实密钥——所有密钥类变量保持空值占位。

# --- API（拍板 D6：简单 token；空 = 关闭认证。勿暴露公网！）--------------
AUTOANIME_API_TOKEN=
AUTOANIME_API_PORT=8000
AUTOANIME_WEB_PORT=3080

# --- 下载器（qBittorrent WebUI；分类标记 autoanime）----------------------
AUTOANIME_DOWNLOADER=qbittorrent
AUTOANIME_QBITTORRENT_HOST=127.0.0.1
AUTOANIME_QBITTORRENT_PORT=8080
AUTOANIME_QBITTORRENT_USERNAME=admin
AUTOANIME_QBITTORRENT_PASSWORD=
# aria2 仅接口 + 离线测试（拍板 D5，不实测）
# AUTOANIME_DOWNLOADER=aria2
# AUTOANIME_ARIA2_RPC_URL=http://127.0.0.1:6800/jsonrpc
# AUTOANIME_ARIA2_SECRET=

# --- 订阅调度（E4）-------------------------------------------------------
AUTOANIME_SCHEDULER_ENABLED=true
AUTOANIME_RSS_POLL_INTERVAL_MINUTES=30
AUTOANIME_RSS_POLL_JITTER_PCT=10
AUTOANIME_DOWNLOAD_POLL_INTERVAL_S=30

# --- L3 LLM（拍板 D19：不配 key = L3 关闭，LOW 全进人工）------------------
AUTOANIME_LLM_ENABLED=false
AUTOANIME_LLM_MODEL=deepseek-chat
AUTOANIME_LLM_BASE_URL=
AUTOANIME_LLM_API_KEY=

# --- 通知（拍板 D3：webhook + telegram；密钥只走 env）---------------------
AUTOANIME_NOTIFY_ENABLED=false
AUTOANIME_NOTIFY_WEBHOOK_URL=
AUTOANIME_NOTIFY_TELEGRAM_BOT_TOKEN=
AUTOANIME_NOTIFY_TELEGRAM_CHAT_ID=

# --- 洗版（D9：allow=跨盘降级 copy；strict=永不 copy）--------------------
AUTOANIME_UPGRADE_THRESHOLD=2
AUTOANIME_UPGRADE_COPY_POLICY=allow
